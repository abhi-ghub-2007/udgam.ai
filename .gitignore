# ---- Secrets: never commit ----
.env
.env.*
!.env.example

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
backend/.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Models / large artifacts ----
backend/models/*.joblib
backend/models/*.pkl
!backend/models/.gitkeep

# ---- OS / editor ----
.vs/
.vscode/
.idea/
Thumbs.db
desktop.ini
*.swp

# ---- Logs / scratch ----
*.log
scratch/

# ---- React frontend build output ----
frontend/node_modules/
# frontend/dist IS committed. The backend serves it (FastAPI mounts it and
# falls back to index.html), so one Render service hosts the whole product:
# same origin for the API, and deep links work because the catch-all route
# handles them rather than a static host 404ing on paths it has no file for.
# Committing the build also means the deploy does not need Node at all.
frontend/dev-dist/

# ML data: raw mandi CSVs are large and not app source
data/raw/
data/processed/
# The trained artifact is 4KB of JSON and MUST deploy with the app --
# the API loads it at runtime. Only the heavy backtest outputs are ignored.
backend/app/ml/artifacts/backtest.json
backend/app/ml/artifacts/chronos_challenger.json
